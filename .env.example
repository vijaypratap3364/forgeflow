# ForgeFlow reads these values from the process environment. It does not load
# this file automatically.
FORGEFLOW_ADDR=127.0.0.1:8080
FORGEFLOW_STORE=file
FORGEFLOW_DATA_PATH=data/forgeflow.ffdb
# Required only when FORGEFLOW_STORE=postgres. Keep real credentials in .env or
# a secret manager; never commit them.
FORGEFLOW_POSTGRES_DSN=
FORGEFLOW_BROKER=memory
# Used only when FORGEFLOW_BROKER=nats. URLs may contain credentials, so keep
# real values outside version control.
FORGEFLOW_NATS_URL=nats://127.0.0.1:4222
FORGEFLOW_NATS_STREAM=FORGEFLOW_TASKS
FORGEFLOW_NATS_SUBJECT_PREFIX=forgeflow.tasks
FORGEFLOW_WORKERS=4
FORGEFLOW_SHUTDOWN_TIMEOUT=10s
# Required. Supply the complete PEM-encoded Ed25519 public key through the real
# process environment (PowerShell example: Get-Content -Raw issuer-public.pem).
FORGEFLOW_JWT_PUBLIC_KEY=
FORGEFLOW_JWT_ISSUER=forgeflow
FORGEFLOW_JWT_AUDIENCE=forgeflow-api
FORGEFLOW_JWT_LEEWAY=30s
FORGEFLOW_RATE_LIMIT=120
FORGEFLOW_RATE_LIMIT_WINDOW=1m
